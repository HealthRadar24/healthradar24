{
  "schemaVersion": 2,
  "openSource": {
    "project": "HealthRadar24",
    "positioning": "open_source_healthcare_and_life_science_intelligence",
    "license": "AGPL-3.0-only",
    "charterDoc": "docs/healthradar-open-source.md",
    "contributionGuide": "CONTRIBUTING.md",
    "sourceProposalTemplate": ".github/ISSUE_TEMPLATE/health_data_source.yml",
    "upstreamRepository": "https://github.com/koala73/worldmonitor",
    "selfHostingSupported": true
  },
  "productBoundary": {
    "purpose": "aggregate situational awareness and research",
    "clinicalUse": "not_for_diagnosis_treatment_or_emergency_guidance",
    "personalData": "not_collected",
    "protectedHealthInformation": "prohibited",
    "medicalDeviceClaim": "prohibited",
    "clinicalDecisionSupport": "prohibited"
  },
  "domains": [
    {
      "id": "publicHealthSurveillance",
      "name": "Public health surveillance",
      "scope": "Outbreak advisories, epidemic case and death trends, vaccine-preventable disease, and immunisation coverage",
      "primarySourceClasses": [
        "who",
        "ecdc",
        "cdc",
        "paho",
        "national_public_health_agency"
      ],
      "exclusions": [
        "patient_level_case_records",
        "clinical_risk_scoring"
      ]
    },
    {
      "id": "environmentalHealth",
      "name": "Environmental health",
      "scope": "Air quality, heat, water quality, and radiation exposure treated as population health screening signals",
      "primarySourceClasses": [
        "openaq",
        "waqi",
        "who_guideline_threshold",
        "national_environment_agency"
      ],
      "exclusions": [
        "individual_exposure_assessment",
        "clinical_exposure_guidance"
      ]
    },
    {
      "id": "pathogenGenomics",
      "name": "Pathogen genomics",
      "scope": "Population-level pathogen lineage and variant surveillance summaries",
      "primarySourceClasses": [
        "nextstrain_open_build",
        "who_weekly_epidemiological_record",
        "public_consortium_summary"
      ],
      "exclusions": [
        "identifiable_human_genomic_data",
        "restricted_sequence_redistribution"
      ]
    },
    {
      "id": "clinicalResearch",
      "name": "Clinical research",
      "scope": "Registered trial starts, status changes, and posted aggregate results",
      "primarySourceClasses": [
        "clinicaltrials_gov",
        "who_ictrp",
        "eu_ctis",
        "isrctn"
      ],
      "exclusions": [
        "participant_level_data",
        "trial_eligibility_recommendations"
      ]
    },
    {
      "id": "regulatoryAndSafety",
      "name": "Regulatory and safety",
      "scope": "Approvals, recalls, safety communications, and aggregate adverse-event signal summaries",
      "primarySourceClasses": [
        "openfda",
        "ema",
        "mhra",
        "national_regulator"
      ],
      "exclusions": [
        "individual_adverse_event_reports_with_identifiers",
        "prescribing_guidance"
      ]
    },
    {
      "id": "biomedicalLiterature",
      "name": "Biomedical literature",
      "scope": "Peer-reviewed publications and explicitly labelled preprints",
      "primarySourceClasses": [
        "europe_pmc",
        "pubmed",
        "medrxiv",
        "biorxiv",
        "journal_feed"
      ],
      "exclusions": [
        "paywalled_full_text_redistribution",
        "preprints_presented_as_peer_reviewed"
      ]
    },
    {
      "id": "healthSupplyChain",
      "name": "Health supply chain",
      "scope": "Drug and device shortages plus manufacturing and logistics disruption context",
      "primarySourceClasses": [
        "fda_shortage_database",
        "ema_shortage_catalogue",
        "regulator_notice",
        "inherited_logistics_layer"
      ],
      "exclusions": [
        "procurement_advice",
        "substitution_recommendations"
      ]
    }
  ],
